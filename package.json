{
  "name": "soundboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:web": "expo export --platform web --output-dir dist/web --source-maps",
    "export:ios": "expo export --platform ios --output-dir dist/ios --source-maps",
    "preview:web": "node scripts/serve-web.mjs",
    "inspect:bundles": "node scripts/inspect-bundles.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "lamejs": "^1.2.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3"
  }
}
